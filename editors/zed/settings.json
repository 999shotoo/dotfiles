// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "format_on_save": "on",
  "proxy": "",
  "agent": {
    "default_model": {
      "effort": "medium",
      "provider": "openrouter",
      "model": "anthropic/claude-haiku-5.5:batch",
      "enable_thinking": true
    },
    "favorite_models": [],
    "model_parameters": []
  },
  "language_models": {
    "opencode": {
      "show_zen_models": true,
      "show_go_models": true
    }
  },
  "cli_default_open_behavior": "existing_window",
  "session": {
    "trust_all_worktrees": true
  },
  "base_keymap": "VSCode",
  "minimap": {
    "show": "always"
  },
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "mode": "bypassPermissions",
        "effort": "high"
      },
      "type": "registry"
    },
    "codex-acp": {
      "default_config_options": {
        "mode": "agent-full-access",
        "collaboration_mode": "plan"
      },
      "type": "registry"
    },
    "cursor": {
      "type": "registry"
    },
    "github-copilot-cli": {
      "default_config_options": {
        "allow_all": "on"
      },
      "type": "registry"
    }
  },
  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "Gruvbox Light",
    "dark": "Gruvbox Dark",
  },
}
